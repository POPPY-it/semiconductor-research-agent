# 环境变量模板：复制为 .env 并填写（.env 已被 gitignore）
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# API 鉴权：X-API-Token 登录换 HttpOnly Cookie（生产环境务必用强随机串）
API_TOKEN=change-me-to-a-long-random-string
# Cookie 签名密钥（留空则从 API_TOKEN 派生；生产建议独立强随机串）
COOKIE_SECRET=

# ---- 企业级策略 ----
# 质检交付策略：caveat=附警示横幅交付 / reject=不通过不交付正文
QA_POLICY=caveat
# 确定性数字引用门禁：报告数字级引用率低于该阈值时门禁不通过（与 LLM 质检独立）
MIN_NUMBER_CITATION_RATE=0.3
# 证据包门禁：报告 URL 必须来自检索结果（URL 落地率低于该阈值视为编造 URL）
MIN_URL_GROUNDING_RATE=0.8
# 单任务 token 预算（估算字符数，超限熔断；实时搜索场景实测约 210~330 万字符，默认 600 万）
TOKEN_BUDGET_CHARS=6000000

# 备用 LLM（可选，主模型连接失败自动切换）
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_MODEL=

# Semantic Scholar API Key（可选，免费申请 https://www.semanticscholar.org/product/api；提高引文检索额度）
SEMANTIC_SCHOLAR_API_KEY=

# MCP 生态：接入的 MCP Server（逗号分隔，当前支持 github/fetch）
MCP_SERVERS=github,fetch
# GitHub Personal Access Token（可选，匿名 10 次/分钟，带 token 30 次/分钟）
GITHUB_TOKEN=

# 队列：thread（单机线程池，默认）/ rq（需 Redis，生产规模化）
APP_QUEUE=thread
REDIS_URL=redis://127.0.0.1:6379/0
